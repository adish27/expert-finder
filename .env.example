# Copy to .env and fill in. .env is gitignored; never commit real keys.

# --- OpenAI (chat + embeddings) ---
OPENAI_API_KEY=
CHAT_MODEL=gpt-4.1-mini                   # or gpt-4.1 for best answer quality
EMBEDDING_MODEL=text-embedding-3-small    # 1536 dims; sets the Pinecone index dimension

# --- Pinecone (vector database) ---
PINECONE_API_KEY=
PINECONE_INDEX=home-services
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1                 # free Starter plan supports aws/us-east-1 only

# --- Neo4j (graph database) ---
# Neo4j AuraDB (free tier is enough): copy the four values from the credentials file Aura
# gives you when you create the instance. For a local server, use bolt://localhost:7687.
NEO4J_URI=neo4j+s://<id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- LangSmith (tracing, evals, prompt/run comparison) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=home-services-expert-finder
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only for EU accounts

# --- mem0 (user memory) ---
# Only needed for the hosted mem0 platform; the open-source mode reuses OpenAI/Pinecone/Neo4j.
# MEM0_API_KEY=

# --- Nebius (optional) ---
# NEBIUS_API_KEY=
